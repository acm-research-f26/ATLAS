# Determine local UTM CRS
def get_utm_epsg(lat, lon):
    """
    Return the appropriate UTM EPSG code
    for a latitude/longitude coordinate.
    """

    zone = int((lon + 180) / 6) + 1

    if lat >= 0:
        return 32600 + zone
    else:
        return 32700 + zone


utm_epsg = get_utm_epsg(lat, lon)

